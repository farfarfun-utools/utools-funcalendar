{
  "pluginName": "时光常伴",
  "version": "1.0.0",
  "description": "时光常伴 FunCalendar：离线双历与黄历，查看阳历、农历、节气、节日、每日宜忌，按事查询吉日",
  "author": "farfarfun",
  "main": "dist/index.html",
  "logo": "logo.png",
  "pluginSetting": { "height": 620 },
  "features": [
    {
      "code": "calendar",
      "explain": "查看阳历、农历、节气与每日宜忌",
      "cmds": ["时光常伴", "FunCalendar", "日历", "万年历", "农历", "黄历"]
    },
    {
      "code": "auspicious",
      "explain": "按嫁娶、搬家、开市等事项查询当月吉日",
      "cmds": ["吉日", "择吉", "黄道吉日"]
    }
  ],
  "platform": ["darwin", "win32", "linux"]
}
